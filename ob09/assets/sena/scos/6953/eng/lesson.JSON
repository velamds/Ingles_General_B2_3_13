ype": "post_question", "contents": {"content": "in an eco-friendly way.", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 7}, {"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "id": 1, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_3", "type": "objective"}], "id": 8}], "_data": [{"type": "instructions", "contents": [{"content": " Eco-friendly tourism!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span> <span class=\"bullet\">Record yourself saying the sentences aloud. </span><span class=\"bullet\">Compare yourself to the audio.</span> ", "type": "text"}, {"content": " You have 2 attempts to submit your answers.", "type": "text"}, {"content": "engenn11le13ob09re5aud01", "type": "audio"}]}, {"content": 2, "type": "template_override"}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "video", "id": 2, "title": "", "contents": [{"type": "video", "value": {"video_src": "engenn11le13ob09re2vid01", "images": [{"image": "", "text": "", "id": 0, "time": "0"}, {"image": "", "text": "If you're thinking about going on a trip, why not do more than just visit temples or suntan on the beach? Humanitarian travel is a way for travelers to improve the lives of people in certain countries, get to know local cultures, make new friends, learn about themselves, and gain a new perspective and new skills.</p>\nGenerally, humanitarian tourists had better be in good health and have a desire to explore. For people finishing secondary school, or those who have graduated from university, there are gap year programs. Other programs are designed for retirees. If you have a specific skill, you can work for a non-profit organization overseas.</p>", "id": 1, "time": "100"}, {"image": "", "text": "Ecotourism is an option that works well for the environmentally conscious. It is a great way to travel to a natural area and help sustain the well-being of the local community. Since examples of ecotourism abound, a potential ecotourist had better learn as much as they can about the trip that awaits them. TIES has created a set of criteria that can be used to determine if a travel project can be considered ecotourism. An example is participating in an Eco-School in Guatemala, in which student tourists learn about the environmental protection and build awareness of cultural landmarks, such as the ancient Mayan ruins of Tikal.</p>", "id": 2, "time": "34500"}, {"image": "", "text": "You had better consider a few other factors before signing up with a travel operator. Volunteering sometimes passes for unregulated, inexpensive labor. Additionally, if you choose a tour package that contains an element of volunteering, you may be buying a lower quality tour at a higher price. Organizations had better be able to prove they have close and permanent local ties, and their projects respond to needs expressed by the local community.  Individuals interested in this type of experience had better do research and compare options carefully.", "id": 3, "time": "66500"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Good Deeds", "type": "lesson_name"}, {"content": " It Makes a Difference ", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Exchange information about unlikely events or fairly certain conditions that will be fulfilled in present, past or future  in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le13ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Had Better", "type": "heading"}, {"content": " You use  <span class=\"strong\">had better</span> in spoken English when you want to express that something is a good idea to do or not. You can use it in place of  <span class=\"strong\">should</span> and  <span class=\"strong\">ought to</span>.", "type": "describer"}, {"content": "In most cases, <span class=\"strong\">had better</span> has a slightly stronger meaning than <span class=\"strong\">should</span> and <span class=\"strong\">ought to</span>. It implies that there might be a negative consequence if you do not do the action.", "type": "text"}, {"content": "For example: <br/><span class=\"italic\">You <span class=\"strong\">had better</span> see the dentist about that tooth.</span> (If you don't, it could get much worse.) ", "type": "text"}, {"content": " You  <span class=\"underline\">do not</span> use <span class=\"strong\">had better</span>  to talk about the past. Instead, you need to use  <span class=\"strong\">should have</span> or <span class=\"strong\">ought to have</span>.", "type": "text"}, {"content": "The negative form is  <span class=\"strong\">had better not</span> and in questions,  the subject comes after <span class=\"strong\">had</span>.", "type": "text"}, {"content": "For example:  <br/><span class=\"italic\">He'<span class=\"strong\">d better not</span> be late again -  he's already in hot water with the boss.<br/> <span class=\"strong\">Had</span> we <span class=\"strong\">better</span> go earlier?</span>", "type": "text"}, {"content": "Generally, humanitarian tourists <span class=\"strong\">had better</span> be in good health and have a desire to explore. ", "type": "example"}, {"content": "Since examples of ecotourism abound, a potential eco-tourist <span class=\"strong\">had better</span> learn as much as they can about the trip that awaits them.", "type": "example"}, {"content": "You <span class=\"strong\">had better</span> consider a few other factors before signing up with a travel operator. ", "type": "example"}, {"content": "Organizations <span class=\"strong\">had better</span> be able to prove they have close and permanent local ties, and their projects respond to needs expressed by the local community.", "type": "example"}, {"content": "Individuals interested in this type of experience <span class=\"strong\">had better</span> do research and compare options carefully.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " First Conditional and Zero Conditional: Conditional Clause and Main Clause", "type": "heading"}, {"content": "Let's look at the two components of a conditional sentence: the conditional clause (If clause) and the main clause (result clause).", "type": "describer"}, {"content": "<span class=\"strong\">Zero Conditional</span><br>  We use the <span class=\"strong\">Zero Conditional</span> to talk about things that are always true.<br> The structure of the <span class=\"strong\">Zero Conditional</span> is the following:  - If + Simple Present (if clause)  + Simple Present (result clause). <br>  For example: <br> <span class=\"italic\">If you don't eat, you die. <br> If you heat ice, it melts.</span> <br><br><span class=\"strong\">First Conditional </span><br> We use the <span class=\"strong\">First Conditional</span> to talk about real possibilities in the present or the future.  <br> The structure of the<span class=\"strong\"> First Conditional</span> is the following: <br>  If + Simple Present, will + Simple Present <br>For example: <br> <span class=\"italic\">If we do not reduce the release of greenhouse gases now, global temperatures will rise.</span><br><br> In the  <span class=\"underline\">conditional clause</span>, you use  <span class=\"italic\">If</span> + Simple Present verb.", "type": "text"}, {"content": "For example:<br/><span class=\"italic\"><span class=\"strong\">If</span> you <span class=\"strong\">see</span> the teacher, ...</span>", "type": "text"}, {"content": "In the  <span class=\"underline\">main clauses</span>, sometimes called the result clause, you have three choices.   <ol><li> <span class=\"italic\">will</span> + infinitive (First Conditional) <br/>   <span class=\"italic\"><span class=\"strong\">If</span> you  <span class=\"strong\">see</span> the teacher, you  <span class=\"strong\">will  have to</span> ask her about the test.</span></li>       <li> Present tense (Zero Conditional)<br/>   <span class=\"italic\"><span class=\"strong\">If</span> you  <span class=\"strong\">see</span> the teacher,  the class <span class=\"strong\">is</span> starting.</span></li>      <li>Imperative<br/>   <span class=\"italic\"> <span class=\"strong\">If</span> you  <span class=\"strong\">see</span> the teacher,  <span class=\"strong\">tell</span> him I will be late.</span></li></ol>", "type": "text"}, {"content": "If you are thinking about going on a trip, why not do more than just visit temples or suntan on the beach?", "type": "example"}, {"content": " If you have a specific skill, you can work for a non-profit organization overseas. ", "type": "example"}, {"content": "Additionally, if you choose a tour package that contains an element of volunteering, you may be buying a lower quality tour at a higher price.", "type": "example"}, {"content": "If you travel responsibly, you can make a difference for both yourself and the local community.  ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "ecotourism", "type": "name"}, {"content": "a form of travel that includes learning about and protection of the natural world", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If you are interested in environmental protection, ecotourism is another way of showing that you are a principled tourist. ", "type": "example"}, {"content": "engenn11le13ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you talk about ecotourism.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "landmark", "type": "name"}, {"content": " a natural or human-made structure that is distinct from everything around", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Student tourists learn about environmental protection and build awareness of cultural landmarks.", "type": "example"}, {"content": "engenn11le13ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "gap year ", "type": "name"}, {"content": "one year many students take to work or travel after high school before entering university", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: For people finishing secondary school, or those who have graduated from university, there are gap year programs. ", "type": "example"}, {"content": "engenn11le13ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "criteria", "type": "name"}, {"content": "a detailed list of actions or descriptions of a product that are used for evaluation purposes", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: TIES has created a set of criteria that can be used to determine if a travel project can be considered ecotourism. ", "type": "example"}, {"content": "engenn11le13ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tour package", "type": "name"}, {"content": "travel arrangements, often including transportation, food, accommodation and excursions, grouped and sold by a travel agency", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Additionally, if you choose a tour package that contains an element of volunteering, you may be buying a lower quality tour at a higher price.", "type": "example"}, {"content": "engenn11le13ob09aud05", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Choose a destination for a humanitarian trip or an ecotourism experience. Go online for ideas.", "type": "text"}, {"content": "Read information about your choice of destination. Find 2 - 3 different sources of information.", "type": "text"}, {"content": "Prepare a brochure a travel agency could use to sell the trip. In the brochure, write 3 - 4 paragraphs describing the trip. Answer the questions: What will the person do and see? How will the trip be useful to the local population?", "type": "text"}, {"content": "Include photos and images in your brochure.", "type": "text"}, {"content": "Invent details for the trip, like price and details related to accommodation, food and transportation.", "type": "text"}, {"content": "Present your brochure to a partner. In your presentation, invite people to ask questions about the trip.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I identify humanitarian and ecotourism experiences.", "type": "text"}, {"content": "I write a text describing the travel experience.", "type": "text"}, {"content": "I explain why the trip is useful.", "type": "text"}, {"content": "I present the brochure and answer questions about the trip.", "type": "text"}]}]}